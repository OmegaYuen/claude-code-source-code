{
  "name": "Acelence Ops Board",
  "short_name": "Ops Board",
  "description": "Daily Airbnb operations: check-outs, arrivals, cleaning status, guest requests and the team feed.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
